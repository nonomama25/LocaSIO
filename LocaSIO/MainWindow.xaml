<Window x:Class="LocaSIO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocaSIO - Interface de test" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TextBlock Text="Interface de test des fonctionnalités LocaSIO" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" />
        
        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <TabItem Header="Agences">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Ville :" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="AgenceVilleTextBox" Width="220" Margin="0,0,8,0" />
                        <Button Content="Créer" Click="CreateAgence_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Supprimer la sélection" Click="DeleteAgence_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Actualiser" Click="RefreshAgences_Click" Padding="14,5" />
                    </StackPanel>
                    
                    <DataGrid x:Name="AgencesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" TextElement.Foreground="Black">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ville" Binding="{Binding Ville}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Clients">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Nom" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ClientNomTextBox" Width="120" Margin="0,0,12,0" />
                        <TextBlock Text="Prénom" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ClientPrenomTextBox" Width="120" Margin="0,0,12,0" />
                        <TextBlock Text="Email" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ClientEmailTextBox" Width="170" Margin="0,0,12,0" />
                        <TextBlock Text="Téléphone" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ClientTelephoneTextBox" Width="120" Margin="0,0,12,0" />
                        <Button Content="Créer" Click="CreateClient_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Supprimer la sélection" Click="DeleteClient_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Actualiser" Click="RefreshClients_Click" Padding="14,5" />
                    </WrapPanel>
                    
                    <DataGrid x:Name="ClientsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" TextElement.Foreground="Black">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
                            <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                        <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="*" />
                        <DataGridTemplateColumn Header="Contrat" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Contrat" Tag="{Binding Id}" Click="OpenClientContrat_Click" Padding="8,3" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Articles">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Libellé" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ArticleLibelleTextBox" Width="150" Margin="0,0,10,0" />
                        <TextBlock Text="Tarif/jour" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ArticleTarifTextBox" Width="80" Margin="0,0,10,0" />
                        <TextBlock Text="Caution" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ArticleCautionTextBox" Width="80" Margin="0,0,10,0" />
                        <TextBlock Text="Agence" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <ComboBox x:Name="ArticleAgenceComboBox" Width="80" Margin="0,0,10,0" DisplayMemberPath="Ville" SelectedValuePath="Id" />
                        <TextBlock Text="Type " VerticalAlignment="Center" Margin="0,0,5,0" />
                        <ComboBox x:Name="ArticleTypeComboBox" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Créer" Click="CreateArticle_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Supprimer la sélection" Click="DeleteArticle_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Actualiser" Click="RefreshArticles_Click" Padding="14,5" />
                    </WrapPanel>
                    
                    <DataGrid x:Name="ArticlesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" TextElement.Foreground="Black">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="*" />
                            <DataGridTextColumn Header="Tarif/jour" Binding="{Binding TarifJournalier}" Width="100" />
                            <DataGridTextColumn Header="Caution" Binding="{Binding Caution}" Width="100" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                            <DataGridTextColumn Header="Agence" Binding="{Binding Agence}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Contrats">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Client" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock x:Name="ContratClientContextTextBlock" Text="Aucun client sélectionné" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="Début" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <DatePicker x:Name="ContratDateDebutPicker" Width="130" Margin="0,0,10,0" />
                        <TextBlock Text="Fin" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <DatePicker x:Name="ContratDateFinPicker" Width="130" Margin="0,0,10,0" />
                        <TextBlock Text="Statut" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ContratStatutTextBox" Width="120" Margin="0,0,10,0" />
                        <TextBlock Text="Nom distinctif" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ContratDistinguishedNameTextBox" Width="180" Margin="0,0,10,0" />
                        <Button Content="Créer" Click="CreateContrat_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Supprimer la sélection" Click="DeleteContrat_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Actualiser" Click="RefreshContrats_Click" Padding="14,5" />
                    </WrapPanel>

                    <DataGrid x:Name="ContratsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" TextElement.Foreground="Black">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Début" Binding="{Binding DateDebut}" Width="*" />
                            <DataGridTextColumn Header="Fin" Binding="{Binding DateFin}" Width="*" />
                            <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="*" />
                            <DataGridTextColumn Header="Nom distinctif" Binding="{Binding DistinguishedName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="Prêt." Foreground="DarkSlateGray" Margin="0,12,0,0" />
    </Grid>
</Window>