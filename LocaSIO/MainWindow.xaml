<Window x:Class="LocaSIO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocaSIO - Interface de test" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Interface de test des fonctionnalités LocaSIO" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" />
        <TabControl Grid.Row="1">
            <TabItem Header="Agences">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Ville :" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="AgenceVilleTextBox" Width="220" Margin="0,0,8,0" />
                        <Button Content="Créer" Click="CreateAgence_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Supprimer la sélection" Click="DeleteAgence_Click" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="Actualiser" Click="RefreshAgences_Click" Padding="14,5" />
                    </StackPanel>
                    <DataGrid x:Name="AgencesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns><DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="100" /><DataGridTextColumn Header="Ville" Binding="{Binding Ville}" Width="*" /></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Clients">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Nom" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="ClientNomTextBox" Width="120" Margin="0,0,12,0" />
                        <TextBlock Text="Prénom" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="ClientPrenomTextBox" Width="120" Margin="0,0,12,0" />
                        <TextBlock Text="Email" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="ClientEmailTextBox" Width="170" Margin="0,0,12,0" />
                        <TextBlock Text="Téléphone" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="ClientTelephoneTextBox" Width="120" Margin="0,0,12,0" />
                        <Button Content="Créer" Click="CreateClient_Click" Padding="14,5" Margin="0,0,8,0" /><Button Content="Supprimer la sélection" Click="DeleteClient_Click" Padding="14,5" Margin="0,0,8,0" /><Button Content="Actualiser" Click="RefreshClients_Click" Padding="14,5" />
                    </WrapPanel>
                    <DataGrid x:Name="ClientsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns><DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" /><DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" /><DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*" /><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" /><DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="*" /></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Articles">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Libellé" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="ArticleLibelleTextBox" Width="150" Margin="0,0,10,0" />
                        <TextBlock Text="Tarif/jour" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="ArticleTarifTextBox" Width="80" Margin="0,0,10,0" />
                        <TextBlock Text="Caution" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="ArticleCautionTextBox" Width="80" Margin="0,0,10,0" />
                        <TextBlock Text="Id agence" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="ArticleAgenceIdTextBox" Width="70" Margin="0,0,10,0" />
                        <CheckBox x:Name="ArticleDisponibleCheckBox" Content="Disponible" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Créer" Click="CreateArticle_Click" Padding="14,5" Margin="0,0,8,0" /><Button Content="Supprimer la sélection" Click="DeleteArticle_Click" Padding="14,5" Margin="0,0,8,0" /><Button Content="Actualiser" Click="RefreshArticles_Click" Padding="14,5" />
                    </WrapPanel>
                    <DataGrid x:Name="ArticlesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns><DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" /><DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="*" /><DataGridTextColumn Header="Tarif/jour" Binding="{Binding TarifJournalier}" Width="100" /><DataGridCheckBoxColumn Header="Disponible" Binding="{Binding Disponible}" Width="100" /><DataGridTextColumn Header="Caution" Binding="{Binding Caution}" Width="100" /><DataGridTextColumn Header="Agence" Binding="{Binding AgenceId}" Width="80" /></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="Prêt." Foreground="DarkSlateGray" Margin="0,12,0,0" />
    </Grid>
</Window>